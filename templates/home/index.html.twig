{% extends 'base.html.twig' %}

{% block title %}Accueil - Boutique PPE{% endblock %}

{% block body %}
    {# 
       ASTUCE D'EXPERT : 
       On passe les données de l'utilisateur (s'il existe) dans un attribut "data-user".
       Si app.user existe, on crée un petit JSON avec son nom. Sinon, on met null.
    #}
    <div id="app" 
         data-user="{{ app.user ? { 'username': app.user.username, 'email': app.user.email }|json_encode|e('html_attr') : 'null' }}">
    </div>
{% endblock %}